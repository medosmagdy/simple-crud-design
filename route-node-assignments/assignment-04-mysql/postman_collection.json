      "name": "Create Supplier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/suppliers",
        "description": "Create Supplier. See README for setup, input requirements and error responses.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"SupplierName\": \"Farm\",\n  \"ContactNumber\": \"01000000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('supplierId',pm.response.json().SupplierID);"
            ]
          }
        }
      ]
    },
