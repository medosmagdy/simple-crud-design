{
  "info": {
    "name": "SarahaApp pt.5 - Revised - Muhammad Magdy",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Revised Part 5 export. See README and REFERENCE_REVIEW for source matching scope and setup."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3008"
    },
    {
      "key": "email",
      "value": "student@example.com"
    },
    {
      "key": "password",
      "value": "UseYourOwnLocalTestPassword!"
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Muhammad\",\n  \"lastName\": \"Magdy\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"gender\": \"male\",\n  \"age\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userId',pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm Email - enter received OTP",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/auth/confirm-email",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const data=pm.response.json();pm.collectionVariables.set('accessToken',data.accessToken);pm.collectionVariables.set('refreshToken',data.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/profile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/users/profile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Muhammad\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Upload Profile Picture - select file",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/users/profile-picture",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "profile",
              "type": "file",
              "src": []
            }
          ]
        },
        "description": "Select a PNG/JPEG/WebP file smaller than 2MiB. Use the exact field name profile. This follows the observed instructor route."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('profileImage persisted',()=>pm.expect(pm.response.json().data.profileImage).to.include('uploads/Profiles/'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Send Anonymous Message",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/messages/{{userId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Hello\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('messageId',pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Inbox",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/messages",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Delete Own Message",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/messages/{{messageId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Refresh Tokens",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/refresh-token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const data=pm.response.json();pm.collectionVariables.set('accessToken',data.accessToken);pm.collectionVariables.set('refreshToken',data.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout And Blacklist Both Tokens",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Reject Revoked Access",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/profile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 401',()=>pm.response.to.have.status(401));"]
          }
        }
      ]
    }
  ]
}
