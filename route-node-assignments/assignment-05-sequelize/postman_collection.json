              "pm.collectionVariables.set('postId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Bulk Create Comments",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/comments",
        "description": "Bulk Create Comments. See README for setup, input requirements and error responses.",
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"content\": \"the first comment\",\n    \"userId\": {{userId}},\n    \"postId\": {{postId}}\n  },\n  {\n    \"content\": \"the second comment\",\n    \"userId\": {{userId}},\n    \"postId\": {{postId}}\n  }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('commentId',pm.response.json()[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Own Comment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
