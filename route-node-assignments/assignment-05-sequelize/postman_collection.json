    {
      "name": "Create Post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts",
        "description": "Create Post. See README for setup, input requirements and error responses.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"First Post\",\n  \"content\": \"Assignment post\",\n  \"userId\": {{userId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
